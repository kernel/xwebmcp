#!/usr/bin/env node
// A stand-in for pi in run.test.mjs: declares the --tools it was given and answers in one turn.
const args = process.argv.slice(2);
if (args[0] === "--version") {
  console.log("0.0.0-stub");
  process.exit(0);
}
const tools = args.includes("--tools") ? args[args.indexOf("--tools") + 1].split(",") : [];
const prompt = args.at(-1);
const text = /READY/.test(prompt) ? "READY" : '```json\n{"ip": "8.8.8.8", "country_code": "US", "asn": "AS15169"}\n```';
const events = [
  { type: "message_end", message: { role: "system", toolsAdded: tools.map(name => ({ name })) } },
  { type: "turn_start" },
  { type: "message_end", message: { role: "assistant", content: [{ type: "text", text }], usage: { input: 100, output: 10, cost: { total: 0.01 } }, stopReason: "stop" } },
  { type: "turn_end" },
  { type: "agent_settled" },
];
for (const event of events) console.log(JSON.stringify(event));
