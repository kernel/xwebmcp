{
  "id": "steam-popular-tags",
  "domain": "steampowered.com",
  "stage": "inspect",
  "split": "train",
  "prompt": "On store.steampowered.com, list the first three user-defined tags Steam shows for {{game}}, in the order shown. Reply with JSON: {\"tags\": [string]}.",
  "fixture": {
    "game": "Stardew Valley"
  },
  "start_url": "https://store.steampowered.com/",
  "answer_schema": "schemas/game-tags.json",
  "rules": [
    {
      "path": "tags",
      "count": 3
    },
    {
      "path": "tags",
      "unique": true
    }
  ],
  "agreement": {
    "path": "tags",
    "same": true
  },
  "pairs": 3,
  "trial_timeout_sec": 600,
  "max_turns": 25
}
