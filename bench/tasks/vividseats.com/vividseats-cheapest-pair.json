{
  "id": "vividseats-cheapest-pair",
  "domain": "vividseats.com",
  "stage": "compare",
  "prompt": "On vividseats.com, find the {{team}}'s first home game at {{venue}} between {{start}} and {{end}}, and the cheapest all-in price per ticket Vivid Seats shows for {{quantity}} tickets together. Do not start checkout. Reply with JSON: {\"event\": string, \"date\": \"YYYY-MM-DD\", \"price\": number in US dollars}, the date the venue's local date.",
  "fixture": {
    "team": "New York Knicks",
    "venue": "Madison Square Garden",
    "quantity": 2,
    "start": {
      "days_from_start": 2
    },
    "end": {
      "days_from_start": 45
    }
  },
  "start_url": "https://www.vividseats.com/",
  "answer_schema": "schemas/ticket-price.json",
  "rules": [
    {
      "path": "event",
      "matches": "knicks"
    },
    {
      "path": "date",
      "range": [
        "{{start}}",
        "{{end}}"
      ]
    },
    {
      "path": "price",
      "range": [
        5,
        5000
      ]
    }
  ],
  "agreement": {
    "path": "price",
    "better": "lower",
    "tolerance": 5
  },
  "pairs": 5,
  "trial_timeout_sec": 600,
  "max_turns": 40
}
