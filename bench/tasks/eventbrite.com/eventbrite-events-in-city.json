{
  "id": "eventbrite-events-in-city",
  "domain": "eventbrite.com",
  "stage": "find",
  "prompt": "On eventbrite.com, find three paid events in {{city}} between {{start}} and {{end}} that sell tickets on the site, with each one's name, local date and venue. Reply with JSON: {\"events\": [{\"name\": string, \"date\": \"YYYY-MM-DD\", \"venue\": string}]}.",
  "fixture": {
    "city": "Chicago, IL",
    "start": {
      "days_from_start": 7
    },
    "end": {
      "days_from_start": 21
    }
  },
  "start_url": "https://www.eventbrite.com/",
  "answer_schema": "schemas/events.json",
  "rules": [
    {
      "path": "events",
      "count": [
        3,
        3
      ]
    },
    {
      "path": "events[].date",
      "range": [
        "{{start}}",
        "{{end}}"
      ]
    },
    {
      "path": "events[].name",
      "unique": true
    }
  ],
  "pairs": 5,
  "trial_timeout_sec": 600,
  "max_turns": 40
}
