{
  "id": "youtube-video-details",
  "domain": "youtube.com",
  "stage": "inspect",
  "prompt": "On youtube.com, look up the video with id {{video_id}}: its title, the channel that uploaded it, its length in seconds, its view count and the date it was published. Reply with JSON: {\"title\": string, \"channel\": string, \"duration_seconds\": integer, \"views\": integer, \"published_at\": \"YYYY-MM-DD\"}.",
  "fixture": {
    "video_id": "dQw4w9WgXcQ"
  },
  "start_url": "https://www.youtube.com/",
  "tools": [
    {
      "repo": "kernel/xwebmcp",
      "ref": "hypeship/youtube-search-video",
      "pr": 53
    }
  ],
  "answer_schema": "schemas/video-details.json",
  "rules": [
    {
      "path": "channel",
      "equals": "Rick Astley"
    },
    {
      "path": "title",
      "matches": "never gonna give you up"
    },
    {
      "path": "duration_seconds",
      "range": [
        213,
        214
      ]
    },
    {
      "path": "views",
      "range": [
        1700000000,
        3000000000
      ]
    },
    {
      "path": "published_at",
      "in": [
        "2009-10-24",
        "2009-10-25"
      ]
    }
  ],
  "pairs": 5,
  "trial_timeout_sec": 600,
  "max_turns": 40
}
