{
  "id": "youtube-compare-views",
  "domain": "youtube.com",
  "stage": "compare",
  "split": "train",
  "prompt": "On youtube.com, compare the view counts of the videos with ids {{video_a}} and {{video_b}} and say which has more views. Reply with JSON: {\"views\": {\"<video id>\": integer}, \"more\": string}.",
  "fixture": {
    "video_a": "9bZkp7q19f0",
    "video_b": "dQw4w9WgXcQ"
  },
  "start_url": "https://www.youtube.com/",
  "answer_schema": "schemas/view-comparison.json",
  "rules": [
    {
      "path": "more",
      "equals": "9bZkp7q19f0"
    },
    {
      "path": "views.9bZkp7q19f0",
      "range": [
        4000000000,
        9000000000
      ]
    },
    {
      "path": "views.dQw4w9WgXcQ",
      "range": [
        1500000000,
        4000000000
      ]
    }
  ],
  "pairs": 3,
  "trial_timeout_sec": 600,
  "max_turns": 35
}
