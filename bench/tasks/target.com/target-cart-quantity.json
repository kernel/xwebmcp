{
  "id": "target-cart-quantity",
  "domain": "target.com",
  "stage": "prepare",
  "split": "train",
  "prompt": "On target.com, put {{quantity}} of the {{product}} in the cart (any pack size), then open the cart and stop there. Report the item's title, the quantity in the cart and the cart subtotal. Reply with JSON: {\"product\": string, \"quantity\": integer, \"subtotal\": number}.",
  "fixture": {
    "product": "Pilot G2 gel pens",
    "quantity": 2
  },
  "start_url": "https://www.target.com/",
  "answer_schema": "schemas/cart-line.json",
  "rules": [
    {
      "path": "quantity",
      "equals": 2
    },
    {
      "path": "product",
      "matches": "g2"
    }
  ],
  "check": {
    "extract": {
      "subtotal": "Order summary\\s*\\$\\s*([\\d,]+\\.\\d{2})\\s*subtotal"
    },
    "rules": [
      {
        "path": "url",
        "matches": "^https://www\\.target\\.com/cart"
      },
      {
        "path": "text",
        "matches": "G2"
      },
      {
        "path": "extracted.subtotal",
        "range": [
          1,
          500
        ]
      }
    ],
    "same_as_answer": [
      {
        "answer": "subtotal",
        "end_state": "extracted.subtotal"
      }
    ]
  },
  "pairs": 3,
  "trial_timeout_sec": 900,
  "max_turns": 50
}
