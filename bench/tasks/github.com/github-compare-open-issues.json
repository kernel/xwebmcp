{
  "id": "github-compare-open-issues",
  "domain": "github.com",
  "stage": "compare",
  "split": "test",
  "prompt": "On github.com, compare {{repo_a}} and {{repo_b}}: how many open issues each shows on its Issues tab (not counting pull requests), and which has more. Reply with JSON: {\"open_issues\": {\"<owner/repo>\": integer}, \"more\": \"owner/repo\"}.",
  "fixture": {
    "repo_a": "denoland/deno",
    "repo_b": "oven-sh/bun"
  },
  "start_url": "https://github.com/explore",
  "answer_schema": "schemas/open-issues-comparison.json",
  "rules": [
    {
      "path": "more",
      "equals": "oven-sh/bun"
    },
    {
      "path": "open_issues.oven-sh/bun",
      "range": [
        3000,
        20000
      ]
    },
    {
      "path": "open_issues.denoland/deno",
      "range": [
        300,
        3000
      ]
    }
  ],
  "pairs": 3,
  "trial_timeout_sec": 600,
  "max_turns": 35
}
