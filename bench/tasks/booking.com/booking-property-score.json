{
  "id": "booking-property-score",
  "domain": "booking.com",
  "stage": "inspect",
  "split": "train",
  "prompt": "On booking.com, look up {{hotel}} in {{city}}: its guest review score, how many reviews it has, and its street address. Reply with JSON: {\"score\": number, \"reviews\": integer, \"address\": string}.",
  "fixture": {
    "hotel": "Hotel Arts Barcelona",
    "city": "Barcelona"
  },
  "start_url": "https://www.booking.com/",
  "answer_schema": "schemas/property-score.json",
  "rules": [
    {
      "path": "score",
      "range": [
        7,
        10
      ]
    },
    {
      "path": "reviews",
      "range": [
        500,
        100000
      ]
    },
    {
      "path": "address",
      "matches": "marina"
    }
  ],
  "pairs": 3,
  "trial_timeout_sec": 600,
  "max_turns": 25
}
