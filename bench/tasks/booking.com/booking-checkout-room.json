{
  "id": "booking-checkout-room",
  "domain": "booking.com",
  "stage": "prepare",
  "prompt": "On booking.com, book the cheapest room option at {{hotel}} in {{city}} from {{check_in}} to {{check_out}} for 2 adults in one room, as a guest, with these details. First name: {{first_name}}. Last name: {{last_name}}. Email: {{email}}. Phone: {{phone}}. Address, only if the site asks: {{address}}, {{city_us}} {{zip}}, United States. Use these details exactly as given; if the site rejects one, stop and say so. Continue to the step that asks how you want to pay and stop there without choosing or entering any payment details. Leave marketing, account-creation and sign-in offers unticked. Reply with JSON: {\"room\": string, \"total\": number in US dollars, the total that final step shows in its price summary}.",
  "fixture": {
    "hotel": "SANA Malhoa Hotel",
    "city": "Lisbon",
    "check_in": {
      "days_from_start": 30
    },
    "check_out": {
      "days_from_start": 32
    },
    "first_name": "Alex",
    "last_name": "Testperson",
    "email": "alex.testperson@example.com",
    "phone": "4155550123",
    "address": "1 Telegraph Hill Blvd",
    "city_us": "San Francisco",
    "zip": "94133"
  },
  "start_url": "https://www.booking.com/",
  "tools": [
    {
      "repo": "kernel/xwebmcp",
      "ref": "hypeship/booking-stays",
      "pr": 76
    }
  ],
  "allow": [
    "checkout"
  ],
  "guard": {
    "hosts": [
      "https://secure.booking.com/*",
      "https://paymentcomponent.booking.com/*"
    ],
    "buttons": "^\\s*(complete (my |your )?booking|book now|confirm (and|&) pay|pay now)\\b"
  },
  "steps": [
    {
      "name": "search",
      "url_patterns": [
        "https://www.booking.com/",
        "https://www.booking.com/index.html*",
        "https://www.booking.com/searchresults*"
      ]
    },
    {
      "name": "property",
      "url_patterns": [
        "https://www.booking.com/hotel/*"
      ]
    },
    {
      "name": "checkout",
      "url_patterns": [
        "https://secure.booking.com/book.html*",
        "https://secure.booking.com/tpi_book*"
      ]
    }
  ],
  "answer_schema": "schemas/room-rate.json",
  "rules": [
    {
      "path": "total",
      "range": [
        50,
        10000
      ]
    }
  ],
  "check": {
    "extract": {
      "total": "\\b(?:Total(?: price)?|Price)\\s*\\n\\s*(?:US)?\\$\\s*([\\d,]+(?:\\.\\d{2})?)\\s*\\n\\s*(?:\\(for [^)\\n]*\\)\\s*\\n\\s*)?(?:Includes taxes|Additional charges may apply)"
    },
    "rules": [
      {
        "path": "url",
        "matches": "^https://secure\\.booking\\.com/(?:tpi_)?book(?:\\.[a-z-]+)?\\.html"
      },
      {
        "path": "text",
        "matches": "SANA Malhoa"
      },
      {
        "path": "text",
        "matches": "How do you want to pay\\?"
      },
      {
        "path": "text",
        "matches": "Complete booking"
      },
      {
        "path": "extracted.total",
        "range": [
          50,
          10000
        ]
      }
    ],
    "same_as_answer": [
      {
        "answer": "total",
        "end_state": "extracted.total"
      }
    ]
  },
  "agreement": {
    "path": "total",
    "better": "lower",
    "tolerance": 1
  },
  "opt_in": "needs --stealth: Booking.com renders the payment step only in stealth browsers",
  "pairs": 5,
  "trial_timeout_sec": 1200,
  "max_turns": 100
}
