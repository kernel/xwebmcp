{
  "type": "object",
  "required": [
    "title",
    "channel",
    "duration_seconds",
    "published_at"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "published_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
