{
  "type": "object",
  "required": ["theater", "date", "films"],
  "properties": {
    "theater": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "films": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "showtimes"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "showtimes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } }
        }
      }
    }
  }
}
