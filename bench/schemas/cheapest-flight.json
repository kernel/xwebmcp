{
  "type": "object",
  "required": ["flight_numbers", "departure_time", "price"],
  "properties": {
    "flight_numbers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "departure_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "price": { "type": "number", "exclusiveMinimum": 0 }
  }
}
