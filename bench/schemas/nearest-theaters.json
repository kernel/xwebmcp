{
  "type": "object",
  "required": ["theaters"],
  "properties": {
    "theaters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "first_evening_showtime"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "first_evening_showtime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        }
      }
    }
  }
}
