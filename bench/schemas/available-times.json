{
  "type": "object",
  "required": [
    "restaurant",
    "times"
  ],
  "properties": {
    "restaurant": {
      "type": "string",
      "minLength": 1
    },
    "times": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      }
    }
  }
}
