{
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "date", "venue"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "venue": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
