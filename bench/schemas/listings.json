{
  "type": "object",
  "required": ["listings"],
  "properties": {
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "price", "shop"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "shop": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
