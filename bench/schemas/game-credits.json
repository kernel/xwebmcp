{
  "type": "object",
  "required": [
    "developer",
    "publisher",
    "release_date"
  ],
  "properties": {
    "developer": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
