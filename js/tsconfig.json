{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "xwebmcp": [
        "./src/index.ts"
      ],
      "xwebmcp/react": [
        "./src/react.tsx"
      ],
      "xwebmcp/nextjs": [
        "./src/nextjs.tsx"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
