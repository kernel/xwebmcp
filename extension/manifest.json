{
  "manifest_version": 3,
  "name": "xwebmcp",
  "version": "0.1.0",
  "description": "Runs custom WebMCP tools from kernel/xwebmcp in your own Chrome and exposes every WebMCP tool on the page to local agents.",
  "minimum_chrome_version": "150",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "xwebmcp"},
  "sandbox": {"pages": ["sandbox/sandbox.html"]},
  "side_panel": {"default_path": "sidepanel.html"}
}
